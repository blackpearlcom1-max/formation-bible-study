# Formation Website (Spanish) - Cloudflare Pages Security & Performance Headers

# Global Headers (all pages)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com https://cdn.jsdelivr.net https://unpkg.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formation-backend-production.up.railway.app https://api.formationbible.com https://tdlaxuquplqejvijqiow.supabase.co wss://tdlaxuquplqejvijqiow.supabase.co https://api.stripe.com; frame-src https://js.stripe.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';
  X-Robots-Tag: index, follow

/
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=86400

/*.css
  Cache-Control: public, max-age=31536000, immutable, s-maxage=604800

/*.js
  Cache-Control: public, max-age=31536000, immutable, s-maxage=604800

/*.woff2
  Cache-Control: public, max-age=31536000, immutable, s-maxage=604800

/*.png
  Cache-Control: public, max-age=31536000, immutable, s-maxage=604800

/*.jpg
  Cache-Control: public, max-age=31536000, immutable, s-maxage=604800

/*.svg
  Cache-Control: public, max-age=31536000, immutable, s-maxage=604800
